{
  "manifest_version": 3,
  "name": "TEAR — Torn Element Arrange & Restyle",
  "short_name": "TEAR",
  "description": "Restyle Torn's interface: colors, font, sidebar layout and a hand-editable stylesheet. Cosmetic only.",
  "version": "0.2.0",
  "permissions": [
    "storage",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://www.torn.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.torn.com/*"
      ],
      "js": [
        "lib/model.js",
        "content/torn-css.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.torn.com/*"
      ],
      "css": [
        "content/assets.css",
        "content/features/theme.css",
        "content/features/ticker.css",
        "content/features/card.css",
        "content/features/awards.css",
        "content/features/areas.css",
        "content/features/statusIcons.css",
        "content/features/accountLinks.css",
        "content/features/rings.css",
        "content/features/mobile.css",
        "content/features/grid.css",
        "content/features/pageHeader.css",
        "content/features/panels.css",
        "content/features/sidebarOrder.css",
        "content/features/profiles.css",
        "content/features/logo.css",
        "content/features/header.css",
        "content/features/attackLog.css",
        "content/features/events.css",
        "content/features/loadouts.css",
        "content/features/items.css",
        "content/features/widgets.css",
        "content/dock.css"
      ],
      "js": [
        "content/main.js",
        "content/panel-styles.js",
        "content/settings.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "TEAR"
  }
}
